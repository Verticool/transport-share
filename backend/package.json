{
  "name": "@sharing/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Бэкенд сервиса шеринга самокатов: Fastify 5 + pg (без ORM), свои SQL-миграции.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests scripts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sharing/shared": "*",
    "fastify": "^5.7.0",
    "pg": "^8.21.0",
    "pino": "^9.14.0",
    "ws": "^8.22.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

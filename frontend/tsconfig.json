{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@sharing/shared": ["../shared/src/index.ts"],
      "@sharing/shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "e2e-live",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.live.config.ts"
  ]
}

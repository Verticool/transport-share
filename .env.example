# ---------------------------------------------------------------------------
# transport-sharing — пример окружения. Дефолты рабочие: `cp .env.example .env`
# и `docker compose up --build` достаточно для запуска.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
DB_NAME=sharing
DB_USER=sharing
DB_PASSWORD=sharing
DB_HOST=db
DB_PORT=5434          # наружу; внутри compose-сети всегда 5432

# --- Порты сервисов ---
BACKEND_PORT=3000     # backend слушает здесь внутри сети
FRONTEND_PORT=8088    # наружу открывается только фронт nginx

# --- Аутентификация ---
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Фронтенд ---
# mock — данные из mock/*.json (стадии S2–S7, фронт работает без сервера)
# http — реальный backend через REST + WebSocket (S11+)
VITE_API_MODE=mock

# --- Данные и симулятор ---
SEED_ON_START=true            # бэкенд идемпотентно сеет mock/*.json в БД при старте
SIM_TICK_MS=1000              # шаг симулятора парка
BOOKING_TICK_MS=5000          # шаг контроля брони
BOOKING_TTL_MINUTES=15        # сколько живёт бронь без старта
BOOKING_NOTIFY_MINUTES=3      # за сколько до снятия предупредить
LOW_BATTERY_THRESHOLD=20      # ниже — самокат не показывается свободным
BATTERY_DRAIN_PCT_PER_MIN=1   # расход заряда в поездке

# --- Тарифы (минорные единицы: 1 сом = 100 тыйын) ---
CURRENCY=KGS
CURRENCY_SYMBOL=сом
UNLOCK_FEE_MINOR=2500         # 25.00 сом — разблокировка, один раз на поездку
RIDE_RATE_MINOR=600           # 6.00 сом/мин — езда
PAUSE_RATE_MINOR=200          # 2.00 сом/мин — пауза

# ---------------------------------------------------------------------------
# transport-sharing — настройки локального запуска.
#
# Этот файл ЛЕЖИТ В РЕПОЗИТОРИИ НАМЕРЕННО. Секретов в проекте нет: база поднимается
# локально вместе с сервисом, а все значения ниже — демонстрационные. Смысл в том, чтобы
# проект запускался сразу (`docker compose up -d --build`) и не требовал правки окружения.
#
# Если значения нужно переопределить под свою машину (например, занят порт), правьте здесь
# или задавайте переменную при запуске: `FRONTEND_PORT=8090 docker compose up -d`.
# Полное описание — README.md, раздел «Порты и переменные».
# ---------------------------------------------------------------------------

# --- Порты на хосте (внутри compose-сети приложение работает на своих стандартных портах) ---
FRONTEND_PORT=8088    # сюда открывается интерфейс: http://localhost:8088
DB_PORT=5433          # наружу для psql/отладки; внутри сети база всегда на 5432

# --- База данных ---
# Креды демонстрационные: база доступна только с этой машины и пересоздаётся из mock/.
DB_NAME=sharing
DB_USER=sharing
DB_PASSWORD=sharing

# --- Бэкенд ---
LOG_LEVEL=info
ACCESS_TOKEN_SECRET=local-dev-secret-change-before-real-use
ACCESS_TOKEN_TTL_MINUTES=120   # срок жизни токена доступа
REFRESH_TOKEN_TTL_DAYS=30      # срок жизни токена обновления
SIM_TICK_MS=1000               # шаг симулятора парка, мс
BOOKING_TICK_MS=5000           # шаг обслуживания броней, мс

# --- Источник данных для интерфейса при сборке образа ---
# http — данные с сервера через REST и WebSocket (так собирается контейнер);
# mock — данные из mock/*.json внутри вкладки, чтобы посмотреть интерфейс без базы.
VITE_API_MODE=http

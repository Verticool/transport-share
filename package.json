{
  "name": "transport-sharing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сервис шеринга самокатов: карта парка, бронь, поездки, тарификация. React+Vite / Fastify / PostgreSQL в Docker.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "npm run test:e2e -w frontend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend",
    "metrics": "node scripts/collect-savings.mjs",
    "check:pricing": "node scripts/check-pricing.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
